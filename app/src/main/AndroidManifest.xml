        <activity
            android:name=".presentation.module.ModuleActivity"
            android:exported="false"
            android:theme="@style/Theme.CuDroid" />

        <activity
            android:name=".presentation.portal.PortalActivity"
            android:exported="false"
            android:theme="@style/Theme.CuDroid" />

        <activity
            android:name=".presentation.faculty.FacultyActivity"
            android:exported="false"
            android:theme="@style/Theme.CuDroid" />

        <activity
            android:name=".presentation.classmatelist.ClassmateListActivity"
            android:exported="false"
            android:theme="@style/Theme.CuDroid" />

        <activity
            android:name=".presentation.dashboard.chat.ChatTextListActivity"
            android:exported="false"
            android:theme="@style/Theme.CuDroid" />

    </application>

</manifest>